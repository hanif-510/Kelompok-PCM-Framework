# Salin file ini menjadi .env lalu isi nilainya. Jangan commit .env
# Buat kunci: uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# True hanya di server HTTPS (Render/Railway), False untuk lokal dan Docker lokal
HTTPS_ONLY=False
# Kosong berarti SQLite lokal. Isi URL PostgreSQL untuk Docker atau produksi
DATABASE_URL=